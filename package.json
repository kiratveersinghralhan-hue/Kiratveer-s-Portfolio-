{
  "name": "kirat-independent-edition",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "node scripts/render.mjs && vite --host 127.0.0.1",
    "build": "node scripts/render.mjs && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "check": "node scripts/check.mjs",
    "lint": "eslint src scripts tests vite.config.js eslint.config.js",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node tests/browser.mjs"
  },
  "dependencies": {
    "@fontsource/instrument-serif": "^5.2.5",
    "@fontsource/manrope": "^5.2.6",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.10.0",
    "globals": "17.12.0",
    "playwright": "^1.55.1",
    "vite": "^7.1.7"
  }
}
